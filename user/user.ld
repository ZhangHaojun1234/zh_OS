/* ============================================================================
 * zh_OS 0.2beta (x86_64)
 * File:    user/user.ld
 * Version: 0.2beta
 * Brief:   用户态程序的链接脚本：把自己链接到进程私有窗口的起点 0x40000000。
 *
 * 为什么是这个地址：M5 的 vmm.c 把每个进程的私有窗口固定放在 1GB 处
 * （VMM_USER_BASE = 0x40000000），第一页放代码。所以用户程序必须"生在"
 * 这个地址上 —— 它的绝对地址（例如 .rodata 里的字符串指针）才能在内核
 * 把它搬进进程后依然有效。这也是 Linux 里 ET_EXEC 类型可执行文件的特点
 * （固定装载地址），PIE/动态链接是后面才有的东西。
 * ============================================================================ */

ENTRY(_start)

SECTIONS
{
    . = 0x40000000;

    .text : {
        *(.text*)
    }

    .rodata : {
        *(.rodata*)
    }

    .data : {
        *(.data*)
    }

    .bss : {
        *(COMMON)
        *(.bss*)
    }

    /DISCARD/ : {
        *(.comment) *(.note*) *(.eh_frame*)
    }
}
